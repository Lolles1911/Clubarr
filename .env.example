# Clubarr. In Docker, /config/.env is created on first start; you rarely need
# to edit it. See docs/configuration.md.
APP_NAME=Clubarr
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# The address people use to open Clubarr, e.g. https://club.example.com
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Comma-separated IPs/CIDRs of your reverse proxy, so Clubarr sees the real
# client IP and https. Leave empty without a proxy.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=sqlite
# DB_DATABASE=/config/clubarr.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# true when Clubarr is only reached over https (recommended)
SESSION_SECURE_COOKIE=

QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail is set in the admin (Settings → Mail). These are only the fallback.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="clubarr@example.com"
MAIL_FROM_NAME="${APP_NAME}"
